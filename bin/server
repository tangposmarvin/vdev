#!/usr/bin/env bash
# Updates vdev to the latest version, then starts the server.
# Set VDEV_SKIP_UPDATE=1 to start without updating; VDEV_PORT or VDEV_DATABASE override team.json defaults.
set -euo pipefail

cd "$(dirname "$0")/.."

# The update may replace this script, so start again on the new copy without updating twice.
if [ "${VDEV_SKIP_UPDATE:-}" != "1" ]; then
  if ! bin/update --from-server; then
    printf 'Warning: could not update vdev; starting the current version.\n' >&2
  fi
  VDEV_SKIP_UPDATE=1 exec bin/server "$@"
fi

export PATH="$HOME/.bun/bin:$HOME/.local/bin:$PATH"

if ! command -v bun > /dev/null; then
  printf 'Error: bun not found. Run bin/install first.\n' >&2
  exit 1
fi

if ! command -v claude > /dev/null; then
  printf 'Error: claude not found. Run bin/install first.\n' >&2
  exit 1
fi

if ! claude auth status 2> /dev/null | grep -q '"loggedIn": *true'; then
  printf 'Error: Claude Code is not logged in. Run bin/install first.\n' >&2
  exit 1
fi

[ -f team.json ] || cp team.example.json team.json
exec bun server.ts "$@"
